{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://leakshield-pkgi.onrender.com/api/:match*"
    },
    {
      "source": "/auth/:match*",
      "destination": "https://leakshield-pkgi.onrender.com/auth/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
